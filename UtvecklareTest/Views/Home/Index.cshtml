@using UtvecklareTest.Models
@model DashboardViewModel

@{
    // Dashboard kort data
    var dashboardCards = new List<dynamic> {
        new { 
            Value = Model.Calls.SelectMany(c => c.Employees).Sum(e => e.Calls), 
            Title = "Totala Samtal", 
            Icon = "fas fa-phone", 
            BackgroundClass = "bg-primary"
        },
        new { 
            Value = Model.Employees.Count, 
            Title = "Aktiva Anställda", 
            Icon = "fas fa-users", 
            BackgroundClass = "bg-success"
        },
        new { 
            Value = Model.Dates.Count, 
            Title = "Rapporterade Dagar", 
            Icon = "fas fa-calendar-check", 
            BackgroundClass = "bg-info"
        }
    };
}

<div class="container-fluid dashboard-container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="dashboard-title display-4 mb-3">Dashboard för Telefonsamtal</h1>
            <p class="dashboard-subtitle lead">Överblick över telefonsamtal per kundtjänstmedarbetare och dag</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card dashboard-card bg-white text-dark shadow">
                <div class="card-body">
                    <div class="row text-center">
                        @foreach (var card in dashboardCards)
                        {
                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="dashboard-icon-circle dashboard-icon-@(card.BackgroundClass.Replace("bg-", "")) me-3">
                                        <i class="@card.Icon dashboard-icon-@(card.BackgroundClass.Replace("bg-", ""))"></i>
                                    </div>
                                    <div class="text-start">
                                        <h3 class="dashboard-value mb-1 fw-bold">@card.Value</h3>
                                        <p class="dashboard-label text-muted mb-0">@card.Title</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @Html.Partial("_CallsTable", Model.Calls)
        @Html.Partial("_EmployeeTable", Model.EmployeeStats)
    </div>

    <div class="row">
        @Html.Partial("_EmployeeChart")
        @Html.Partial("_MonthlyChart")
    </div>

    <div class="row">
        @Html.Partial("_TrendChart")
    </div>
</div>

<!-- Chart.js och Font Awesome Libraries-->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

<!-- Dashboard Data -->
<script>
    const employees = @Html.Raw(Json.Serialize(Model.Employees));
    const employeeStats = @Html.Raw(Json.Serialize(Model.EmployeeStats));
    const dates = @Html.Raw(Json.Serialize(Model.Dates));
</script>

<!-- JavaScript Files -->
<script src="~/js/employeeChart.js"></script>
<script src="~/js/monthlyChart.js"></script>
<script src="~/js/trendChart.js"></script>
<script src="~/js/dashboard.js"></script>