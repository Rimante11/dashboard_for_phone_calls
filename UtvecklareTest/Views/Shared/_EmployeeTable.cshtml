@model IEnumerable<dynamic>

<div class="col-md-6 mb-4">
    <div class="card chart-card-modern dashboard-card bg-white text-dark shadow">
        <div class="card-header chart-header border-0 bg-transparent">
            <div class="d-flex align-items-center">
                <div>
                    <h5 class="chart-title">Prestanda per Anställd</h5>
                    <p class="chart-subtitle">Anställdas samtalsstatistik</p>
                </div>
            </div>
        </div>
        <div class="card-body chart-body table-card-body">
            <div class="table-responsive">
                <table class="table table-borderless mb-0">
                    <thead class="sticky-header">
                        <tr class="employee-table-header-row">
                            <th class="employee-table-header">Namn</th>
                            <th class="employee-table-header">Samtal</th>
                            <th class="employee-table-header">Prestanda</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.OrderByDescending(e => e.TotalCalls))
                        {
                            <tr class="employee-table-row">
                                <td class="employee-table-cell">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle me-2 employee-avatar">
                                            @(!string.IsNullOrEmpty(employee.Name) ? employee.Name.Substring(0, 1) : "N/A")
                                        </div>
                                        <span class="employee-name">@employee.Name</span>
                                    </div>
                                </td>
                                <td class="employee-table-cell">
                                    <span class="badge employee-calls-badge">@employee.TotalCalls</span>
                                </td>
                                <td class="employee-progress-cell">
                                    <div class="progress employee-progress-bar-container">
                                        <div class="progress-bar employee-progress-bar" role="progressbar" style="width: @(Math.Round((double)employee.TotalCalls / Model.Max(e => e.TotalCalls) * 100, 1))%" aria-valuenow="@employee.TotalCalls" aria-valuemin="0" aria-valuemax="@Model.Max(e => e.TotalCalls)">
                                        </div>
                                    </div>
                                    <small class="text-muted employee-progress-text">@(Math.Round((double)employee.TotalCalls / Model.Max(e => e.TotalCalls) * 100, 1))%</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>