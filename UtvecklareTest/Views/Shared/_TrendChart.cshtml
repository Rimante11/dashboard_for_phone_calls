<!-- Detailed Trend Analysis Component -->
<div class="col-12">
    <div class="card chart-card-modern dashboard-card bg-white text-dark shadow">
        <div class="card-header chart-header border-0 bg-transparent">
            <div class="d-flex align-items-center">
                <div class="chart-icon chart-icon-cyan">
                    <i class="fas fa-chart-area"></i>
                </div>
                <div>
                    <h5 class="chart-title">Detaljerad Trendanalys</h5>
                    <p class="chart-subtitle">Kombinerad daglig fördelning per anställd</p>
                </div>
            </div>
        </div>
        <div class="card-body chart-body">
            <div class="chart-container">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const trendCtx = document.getElementById('trendChart')?.getContext('2d');
        if (trendCtx && typeof employees !== 'undefined' && typeof employeeStats !== 'undefined' && typeof dates !== 'undefined') {
            
            new Chart(trendCtx, {
                type: 'bar',
                data: {
                    labels: dates,
                    datasets: employees.map((employee, index) => {
                        const employeeData = employeeStats.find(e => e.name === employee);
                        const colors = [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)', 
                            'rgba(255, 205, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ];
                        
                        return {
                            label: employee,
                            data: dates.map(date => {
                                const dayData = employeeData.dailyCalls.find(d => d.date === date);
                                return dayData ? dayData.calls : 0;
                            }),
                            backgroundColor: colors[index % colors.length],
                            borderColor: colors[index % colors.length].replace('0.7', '1'),
                            borderWidth: 1
                        };
                    })
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Daglig Fördelning per Anställd'
                        }
                    },
                    scales: {
                        x: {
                            stacked: false,
                            title: {
                                display: true,
                                text: 'Datum'
                            }
                        },
                        y: {
                            stacked: false,
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Antal Samtal'
                            }
                        }
                    }
                }
            });
        }
    });
</script>